# Claude Code personal/local settings (e.g. hooks installed by `npx impeccable install`)
.claude/settings.local.json

# Agent skills, agent definitions, and installed-skill metadata.
# Installed per developer (npx skills add / npx impeccable install), not shared via git.
.claude/skills/
.claude/agents/
.agents/
skills-lock.json

# Codex instructions and local agent state, installed per developer.
/AGENTS.md
/.codex/

# Python bytecode caches
__pycache__/
*.pyc

# Match launcher environments and cached engine package
backend/.venvs/
backend/.cache/

# Local web development and generated frontend output
frontend/node_modules/
frontend/dist/
frontend/test-results/
frontend/playwright-report/
backend/webapp/.state/
